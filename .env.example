# ── AI Engine Configuration ──
WHISPER_MODEL=small

# ── Firebase Configuration ──
# Absolute path to the Firebase Admin SDK service account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=/absolute/path/to/serviceAccountKey.json

# ── 3rd Party APIs ──
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Relational DB (Optional/Legacy) ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DB=ScribeDB

# ── MongoDB Setup (Primary DB) ──
# The primary Atlas cluster connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Server Config ──
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5173
JWT_SECRET=your_secure_jwt_secret_here